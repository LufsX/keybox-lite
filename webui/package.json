{
  "name": "keybox-lite-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser-runner.mjs",
    "test:browser:install": "playwright install chromium",
    "check:all": "npm run check && npm test && npm run test:browser && npm run build",
    "dev": "vite"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "playwright": "1.58.1",
    "svelte": "^5.0.0",
    "svelte-check": "4.3.3",
    "tailwindcss": "^4.0.0",
    "terser": "5.51.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "kernelsu": "^3.0.2",
    "lucide-svelte": "^0.460.0",
    "tiny-pinyin": "1.3.2"
  }
}
